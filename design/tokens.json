{
  "name": "CareFlow",
  "version": "0.1.0",
  "status": "DRAFT, NOT CLINICALLY APPROVED",
  "platforms": [
    "iOS",
    "Android"
  ],
  "units": {
    "iOS": "pt",
    "Android": "dp/sp for text"
  },
  "color": {
    "light": {
      "background": "#F5F8FC",
      "surface": "#FFFFFF",
      "surfaceSecondary": "#EEF2F7",
      "textPrimary": "#101828",
      "textSecondary": "#475467",
      "textDisabled": "#667085",
      "borderDecorative": "#D0D5DD",
      "borderInteractive": "#667085",
      "primary": "#155EEF",
      "onPrimary": "#FFFFFF",
      "link": "#0B4A9E",
      "focus": "#155EEF",
      "danger": "#B42318",
      "onDanger": "#FFFFFF",
      "dangerSubtle": "#FEF3F2",
      "success": "#027A48",
      "onSuccess": "#FFFFFF",
      "infoSubtle": "#EFF8FF"
    },
    "dark": {
      "background": "#0B1220",
      "surface": "#162238",
      "surfaceSecondary": "#202E45",
      "textPrimary": "#E5E7EB",
      "textSecondary": "#AAB8CC",
      "textDisabled": "#94A3B8",
      "borderDecorative": "#415169",
      "borderInteractive": "#AAB8CC",
      "primary": "#7FB2FF",
      "onPrimary": "#0B1220",
      "link": "#A7C8FF",
      "focus": "#7FB2FF",
      "danger": "#FFB4AB",
      "onDanger": "#29120E",
      "dangerSubtle": "#391F26",
      "success": "#70E1A4",
      "onSuccess": "#0B1220",
      "infoSubtle": "#143553"
    }
  },
  "typography": {
    "family": [
      "Be Vietnam Pro",
      "Noto Sans",
      "System"
    ],
    "body": {
      "size": 17,
      "lineHeight": 25,
      "weight": 400
    },
    "bodySmall": {
      "size": 15,
      "lineHeight": 22,
      "weight": 400
    },
    "headline": {
      "size": 24,
      "lineHeight": 32,
      "weight": 700
    },
    "title": {
      "size": 20,
      "lineHeight": 28,
      "weight": 650
    },
    "label": {
      "size": 14,
      "lineHeight": 20,
      "weight": 600
    },
    "caption": {
      "size": 13,
      "lineHeight": 19,
      "weight": 400
    },
    "scaling": "Use Dynamic Type iOS and user fontScale Android; sizes are baselines not locked"
  },
  "size": {
    "touchTarget": {
      "iosPt": 44,
      "androidDp": 48
    },
    "primaryButtonHeight": 52,
    "cardCornerRadius": 20,
    "buttonCornerRadius": 14,
    "fieldCornerRadius": 12,
    "bottomTabMaxItems": 4
  },
  "spacing": {
    "xs": 4,
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 20,
    "2xl": 24,
    "3xl": 32,
    "4xl": 40
  },
  "motion": {
    "reducedMotionSupported": true,
    "essentialTransitionsOnly": true
  },
  "components": [
    "AppShell",
    "AppointmentCard",
    "PersonContextBadge",
    "PersonSelector",
    "PrimaryButton",
    "ClinicSupportAction",
    "JourneyTimeline",
    "BookingStepper",
    "ScreeningWarning",
    "QueueCard",
    "VideoPreflight",
    "VideoFailure",
    "PaymentStatus",
    "ResultCard",
    "FollowupTask",
    "AccessibleTabBar"
  ],
  "rules": [
    "No medical advice automatically generated",
    "Cannot bypass urgent screening without clinic-approved workflow",
    "Every healthcare resource authorized against current subject",
    "QR display does not imply paid",
    "Use color plus text for status",
    "Clinic phone access available on critical screens"
  ],
  "contrastSpotChecks": {
    "lightPrimaryButton": 5.41,
    "lightBodyText": 17.75,
    "lightSecondaryText": 7.69,
    "lightLink": 8.44,
    "lightDanger": 6.57,
    "darkPrimaryButton": 8.66,
    "darkBodyText": 15.12,
    "darkSecondaryTextOnSurface": 7.91
  }
}
