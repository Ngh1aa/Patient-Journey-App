{
  "name": "CareFlow",
  "version": "4.0.0-preview",
  "status": "DRAFT, NOT CLINICALLY APPROVED",
  "platforms": [
    "iOS",
    "Android"
  ],
  "units": {
    "iOS": "pt",
    "Android": "dp/sp for text",
    "browser": "CSS px; not native pt/dp"
  },
  "color": {
    "light": {
      "background": "#F2F2F2",
      "surface": "#FFFFFF",
      "surfaceSecondary": "#EBEBEE",
      "textPrimary": "#242424",
      "textSecondary": "#57575F",
      "textDisabled": "#606066",
      "borderDecorative": "#DCDCE0",
      "borderInteractive": "#76767B",
      "primary": "#075FE8",
      "onPrimary": "#FFFFFF",
      "link": "#0754CA",
      "focus": "#0754CA",
      "danger": "#B42318",
      "onDanger": "#FFFFFF",
      "dangerSubtle": "#FDE9E7",
      "success": "#16734B",
      "onSuccess": "#FFFFFF",
      "infoSubtle": "#EAF1FF"
    },
    "dark": {
      "background": "#0B1220",
      "surface": "#162238",
      "surfaceSecondary": "#202E45",
      "textPrimary": "#E5E7EB",
      "textSecondary": "#AAB8CC",
      "textDisabled": "#94A3B8",
      "borderDecorative": "#415169",
      "borderInteractive": "#AAB8CC",
      "primary": "#7FB2FF",
      "onPrimary": "#0B1220",
      "link": "#A7C8FF",
      "focus": "#7FB2FF",
      "danger": "#FFB4AB",
      "onDanger": "#29120E",
      "dangerSubtle": "#391F26",
      "success": "#70E1A4",
      "onSuccess": "#0B1220",
      "infoSubtle": "#143553",
      "status": "REFERENCE_ONLY_NOT_IMPLEMENTED"
    }
  },
  "typography": {
    "family": [
      "Be Vietnam Pro",
      "system-ui",
      "sans-serif"
    ],
    "body": {
      "size": 16,
      "lineHeight": 25.6,
      "weight": 400
    },
    "bodySmall": {
      "size": 15,
      "lineHeight": 22,
      "weight": 400
    },
    "headline": {
      "size": 34,
      "lineHeight": 39.8,
      "weight": 700
    },
    "title": {
      "size": 21,
      "lineHeight": 27.3,
      "weight": 700
    },
    "label": {
      "size": 14,
      "lineHeight": 20,
      "weight": 600
    },
    "caption": {
      "size": 13,
      "lineHeight": 19,
      "weight": 400
    },
    "scaling": "Browser large-text setting doubles CSS type sizes (200%). Native Dynamic Type/fontScale NOT_RUN."
  },
  "size": {
    "touchTarget": {
      "iosPt": 44,
      "androidDp": 48
    },
    "primaryButtonHeight": 52,
    "cardCornerRadius": 30,
    "buttonCornerRadius": 999,
    "fieldCornerRadius": 20,
    "bottomTabMaxItems": 4,
    "bottomTabCornerRadius": 999,
    "browserTouchTarget": 44
  },
  "spacing": {
    "xs": 4,
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 20,
    "2xl": 24,
    "3xl": 32,
    "4xl": 40
  },
  "motion": {
    "reducedMotionSupported": true,
    "essentialTransitionsOnly": true
  },
  "components": [
    "AppShell",
    "AppointmentCard",
    "PersonContextBadge",
    "PersonSelector",
    "PrimaryButton",
    "ClinicSupportAction",
    "JourneyTimeline",
    "BookingStepper",
    "ScreeningWarning",
    "QueueCard",
    "VideoPreflight",
    "VideoFailure",
    "PaymentStatus",
    "ResultCard",
    "FollowupTask",
    "AccessibleTabBar"
  ],
  "rules": [
    "No medical advice automatically generated",
    "Cannot bypass urgent screening without clinic-approved workflow",
    "Every healthcare resource authorized against current subject",
    "QR display does not imply paid",
    "Use color plus text for status",
    "Clinic phone access available on critical screens"
  ],
  "contrastSpotChecks": {
    "status": "See runtime axe and prototype/check-contrast.cjs; old ratios removed as stale"
  },
  "implementation": "prototype/styles.css + prototype/editorial-soft-glass.css",
  "visualDirection": {
    "name": "Editorial Soft Glass",
    "reference": "Three visual references supplied by the product owner, October 2026",
    "principles": [
      "Editorial headline scale for high-priority screens; not universal oversized clinical text",
      "Neutral paper background, charcoal typography, high-contrast electric blue",
      "Large soft radii, one frosted floating navigation and optional elevated card panel",
      "Keep every role, status, consent, action and appointment guard from the canonical model",
      "Use existing Be Vietnam Pro and meaningful navigation icons, never copy reference placeholder content"
    ],
    "stylesheets": [
      "prototype/styles.css",
      "prototype/editorial-soft-glass.css"
    ],
    "accessibility": "Browser runtime, text scaling and contrast need fresh checks on every PR"
  }
}
