  "platforms": [
    "iOS",
    "Android"
  ],
  "units": {
    "iOS": "pt",
    "Android": "dp/sp for text",
    "browser": "CSS px; not native pt/dp"
  },
  "color": {
    "light": {
      "background": "#F2F5FA",
      "surface": "#FFFFFF",
      "surfaceSecondary": "#EBEBEE",
      "textPrimary": "#24334A",
      "textSecondary": "#546278",
      "textDisabled": "#546278",
      "borderDecorative": "#DCE3ED",
      "borderInteractive": "#7B8799",
      "primary": "#075FE8",
      "onPrimary": "#FFFFFF",
      "link": "#0754CA",
      "focus": "#0754CA",
      "danger": "#B42318",
      "onDanger": "#FFFFFF",
      "dangerSubtle": "#FDE9E7",
      "success": "#16734B",
      "onSuccess": "#FFFFFF",
      "infoSubtle": "#EAF1FF"
    },
    "dark": {
      "background": "#0B1220",
      "surface": "#162238",
      "surfaceSecondary": "#202E45",
      "textPrimary": "#E5E7EB",
      "textSecondary": "#AAB8CC",
      "textDisabled": "#94A3B8",
      "borderDecorative": "#415169",
      "borderInteractive": "#AAB8CC",
      "primary": "#7FB2FF",
      "onPrimary": "#0B1220",
      "link": "#A7C8FF",
      "focus": "#7FB2FF",
      "danger": "#FFB4AB",
      "onDanger": "#29120E",
      "dangerSubtle": "#391F26",
      "success": "#70E1A4",
      "onSuccess": "#0B1220",
      "infoSubtle": "#143553",
      "status": "REFERENCE_ONLY_NOT_IMPLEMENTED"
    }
  },
  "typography": {
    "family": [
      "Be Vietnam Pro",
      "system-ui",
      "sans-serif"
    ],
    "body": {
      "size": 16,
      "lineHeight": 25.6,
      "weight": 400
    },
    "bodySmall": {
      "size": 15,
      "lineHeight": 22,
      "weight": 400
    },
    "headline": {
      "size": 34,
      "lineHeight": 39.8,
      "weight": 700
    },
    "title": {
      "size": 21,
      "lineHeight": 27.3,
      "weight": 700
    },
    "label": {
      "size": 14,
      "lineHeight": 20,
      "weight": 600
    },
    "caption": {
      "size": 13,
      "lineHeight": 19,
      "weight": 400
    },
    "scaling": "Browser large-text setting doubles CSS type sizes (200%). Native Dynamic Type/fontScale NOT_RUN."
  },
  "size": {
    "touchTarget": {
      "iosPt": 44,
      "androidDp": 48
    },
    "primaryButtonHeight": 52,
    "cardCornerRadius": 26,
    "buttonCornerRadius": 999,
    "fieldCornerRadius": 16,
    "bottomTabMaxItems": 5,
    "bottomTabCornerRadius": 30,
    "browserTouchTarget": 44,
    "bottomNavigationDestinations": 4,
    "bottomNavigationActions": 1
  },
  "spacing": {
    "xs": 4,
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 20,
    "2xl": 24,
    "3xl": 32,
    "4xl": 40
  },
  "motion": {
    "reducedMotionSupported": true,
    "essentialTransitionsOnly": true
  },
  "components": [
    "AppShell",
    "AppointmentCard",
    "PersonContextBadge",
    "PersonSelector",
    "PrimaryButton",
    "ClinicSupportAction",
    "JourneyTimeline",
    "BookingStepper",
    "ScreeningWarning",
    "QueueCard",
    "VideoPreflight",
    "VideoFailure",
    "PaymentStatus",
    "ResultCard",
    "FollowupTask",
    "AccessibleTabBar"
  ],
  "rules": [
    "No medical advice automatically generated",
    "Cannot bypass urgent screening without clinic-approved workflow",
    "Every healthcare resource authorized against current subject",
    "QR display does not imply paid",
    "Use color plus text for status",
    "Clinic phone access available on critical screens"
  ],
  "contrastSpotChecks": {
    "status": "See runtime axe and prototype/check-contrast.cjs; old ratios removed as stale"
  },
  "implementation": "prototype/styles.css + prototype/editorial-soft-glass.css",
  "visualDirection": {
    "name": "Calm Clinical / reference layout",
    "reference": "Two healthcare mobile references supplied by the user, 16 October 2026",
    "principles": [
      "Preserve CareFlow blue #075FE8; transfer the reference composition rather than teal branding",
      "Blue-to-light Home header, one appointment per card with date block and distinct status",
      "Four destinations plus central blue booking action; preserve draft on return",
      "Five booking stages with independent safety screening guards",
      "Grouped label/value details, illustrated choice controls and compact date/time selection",
      "Shared components across all 47 routes; meaningful states and recovery remain model-owned"
    ],
    "stylesheets": [
      "prototype/styles.css",
      "prototype/editorial-soft-glass.css"
    ],
    "accessibility": "Browser runtime, text scaling and contrast need fresh checks on every PR"
  }
}
