{
  "name": "CareFlow",
  "version": "3.0.0",
  "status": "DRAFT, NOT CLINICALLY APPROVED",
  "platforms": [
    "iOS",
    "Android"
  ],
  "units": {
    "iOS": "pt",
    "Android": "dp/sp for text",
    "browser": "CSS px; not native pt/dp"
  },
  "color": {
    "light": {
      "background": "#F2F6FB",
      "surface": "#FFFFFF",
      "surfaceSecondary": "#EEF2F7",
      "textPrimary": "#162535",
      "textSecondary": "#3C5268",
      "textDisabled": "#5E7285",
      "borderDecorative": "#D8E3EE",
      "borderInteractive": "#718398",
      "primary": "#0A67D1",
      "onPrimary": "#FFFFFF",
      "link": "#0756AE",
      "focus": "#0754AF",
      "danger": "#B42318",
      "onDanger": "#FFFFFF",
      "dangerSubtle": "#FDE9E7",
      "success": "#16734B",
      "onSuccess": "#FFFFFF",
      "infoSubtle": "#E7F2FC"
    },
    "dark": {
      "background": "#0B1220",
      "surface": "#162238",
      "surfaceSecondary": "#202E45",
      "textPrimary": "#E5E7EB",
      "textSecondary": "#AAB8CC",
      "textDisabled": "#94A3B8",
      "borderDecorative": "#415169",
      "borderInteractive": "#AAB8CC",
      "primary": "#7FB2FF",
      "onPrimary": "#0B1220",
      "link": "#A7C8FF",
      "focus": "#7FB2FF",
      "danger": "#FFB4AB",
      "onDanger": "#29120E",
      "dangerSubtle": "#391F26",
      "success": "#70E1A4",
      "onSuccess": "#0B1220",
      "infoSubtle": "#143553",
      "status": "REFERENCE_ONLY_NOT_IMPLEMENTED"
    }
  },
  "typography": {
    "family": [
      "Be Vietnam Pro",
      "system-ui",
      "sans-serif"
    ],
    "body": {
      "size": 16,
      "lineHeight": 25.6,
      "weight": 400
    },
    "bodySmall": {
      "size": 15,
      "lineHeight": 22,
      "weight": 400
    },
    "headline": {
      "size": 26,
      "lineHeight": 33.8,
      "weight": 700
    },
    "title": {
      "size": 18,
      "lineHeight": 27,
      "weight": 600
    },
    "label": {
      "size": 14,
      "lineHeight": 20,
      "weight": 600
    },
    "caption": {
      "size": 13,
      "lineHeight": 19,
      "weight": 400
    },
    "scaling": "Browser large-text setting doubles CSS type sizes (200%). Native Dynamic Type/fontScale NOT_RUN."
  },
  "size": {
    "touchTarget": {
      "iosPt": 44,
      "androidDp": 48
    },
    "primaryButtonHeight": 52,
    "cardCornerRadius": 24,
    "buttonCornerRadius": 26,
    "fieldCornerRadius": 14,
    "bottomTabMaxItems": 4,
    "bottomTabCornerRadius": 34,
    "browserTouchTarget": 44
  },
  "spacing": {
    "xs": 4,
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 20,
    "2xl": 24,
    "3xl": 32,
    "4xl": 40
  },
  "motion": {
    "reducedMotionSupported": true,
    "essentialTransitionsOnly": true
  },
  "components": [
    "AppShell",
    "AppointmentCard",
    "PersonContextBadge",
    "PersonSelector",
    "PrimaryButton",
    "ClinicSupportAction",
    "JourneyTimeline",
    "BookingStepper",
    "ScreeningWarning",
    "QueueCard",
    "VideoPreflight",
    "VideoFailure",
    "PaymentStatus",
    "ResultCard",
    "FollowupTask",
    "AccessibleTabBar"
  ],
  "rules": [
    "No medical advice automatically generated",
    "Cannot bypass urgent screening without clinic-approved workflow",
    "Every healthcare resource authorized against current subject",
    "QR display does not imply paid",
    "Use color plus text for status",
    "Clinic phone access available on critical screens"
  ],
  "contrastSpotChecks": {
    "status": "See runtime axe and prototype/check-contrast.cjs; old ratios removed as stale"
  },
  "implementation": "prototype/styles.css"
}
